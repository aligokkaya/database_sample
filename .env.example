DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/discovery_db
SYNC_DATABASE_URL=postgresql://postgres:postgres@db:5432/discovery_db

# --- LLM CONFIGURATION (Ollama / OpenAI) ---
# Use http://host.docker.internal:11434/v1 for local Ollama running on Mac/Windows/Linux host
# Use https://api.openai.com/v1 for cloud-based OpenAI
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
OPENAI_MODEL=qwen2.5:3b
OPENAI_API_KEY=ollama

# --- HARDWARE REQUIREMENTS ---
# Minimum: 8GB RAM (Works with qwen2.5:3b)
# Recommended: 16GB+ RAM / NVIDIA GPU 8GB+ VRAM or Apple M-Series (Matches 7b models)
# PII discovery is near-instant when running Ollama natively on host with GPU.

JWT_SECRET_KEY=your_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=admin123
ENCRYPTION_KEY=your_fernet_key_here
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=discovery_db
